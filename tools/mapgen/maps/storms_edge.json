  "objects": [
    {
      "id": "LOCALID_STORMS_EDGE_ECLAIR",
      "gfx": "OBJ_EVENT_GFX_WORKER_F",
      "x": 8,
      "y": 10,
      "move": "MOVEMENT_TYPE_FACE_DOWN",
      "text": "ECLAIR: The whole grid tripped when\nthe storm hit. Help me bring it back\\pand we'll talk about a badge."
    },
    {
      "id": "LOCALID_STORMS_EDGE_BRIDGE_TENDER",
      "gfx": "OBJ_EVENT_GFX_WORKER_M",
      "x": 21,
      "y": 14,
      "move": "MOVEMENT_TYPE_FACE_UP",
      "text": "The surge fried the bridge motor.\nShe stays up till the power's back."
    },
    {
      "id": "LOCALID_STORMS_EDGE_FISHERMAN",
      "gfx": "OBJ_EVENT_GFX_FISHERMAN",
      "x": 11,
      "y": 32,
      "move": "MOVEMENT_TYPE_FACE_DOWN",
      "text": "After a blow the fish crowd the\nriver mouth. Got a rod, kid?"
    },
    {
      "id": "LOCALID_STORMS_EDGE_LINEMAN",
      "gfx": "OBJ_EVENT_GFX_MAN_2",
      "x": 17,
      "y": 3,
      "move": "MOVEMENT_TYPE_FACE_RIGHT",
      "text": "Three poles down in one night.\nStay clear of those wires!"
    },
    {
      "id": "LOCALID_STORMS_EDGE_KID",
      "gfx": "OBJ_EVENT_GFX_LITTLE_BOY",
      "x": 16,
      "y": 10,
      "move": "MOVEMENT_TYPE_WANDER_AROUND",
      "text": "The Pokémon Center runs on a\ngenerator now. Chug chug chug!"
    },
    {
      "id": "LOCALID_STORMS_EDGE_FISHMONGER",
      "gfx": "OBJ_EVENT_GFX_WOMAN_2",
      "x": 13,
      "y": 17,
      "move": "MOVEMENT_TYPE_FACE_RIGHT",
      "text": "Shrimp's cheap today. Half the\nboats are still tied up."
    },
    {
      "id": "LOCALID_STORMS_EDGE_SAILOR",
      "gfx": "OBJ_EVENT_GFX_SAILOR",
      "x": 42,
      "y": 21,
      "move": "MOVEMENT_TYPE_FACE_LEFT",
      "text": "The surge came right up to the\nstilts. That's what they're for!"
    },
    {
      "id": "LOCALID_STORMS_EDGE_GRANNY",
      "gfx": "OBJ_EVENT_GFX_OLD_WOMAN",
      "x": 4,
      "y": 15,
      "move": "MOVEMENT_TYPE_FACE_DOWN",
      "text": "We raised our houses after the last\nbig storm. Saved us again."
    },
    {
      "id": "LOCALID_STORMS_EDGE_KEEPER",
      "gfx": "OBJ_EVENT_GFX_OLD_MAN",
      "x": 44,
      "y": 30,
      "move": "MOVEMENT_TYPE_FACE_LEFT",
      "text": "My lamp's been dark since the storm.\nShips can't find the mouth at night."
    },
    {
      "id": "LOCALID_STORMS_EDGE_DECKHAND",
      "gfx": "OBJ_EVENT_GFX_SAILOR",
      "x": 30,
      "y": 14,
      "move": "MOVEMENT_TYPE_FACE_LEFT",
      "text": "The bridge motor's fried. Nothing\ncrosses till the grid is back."
    },
    {
      "id": "LOCALID_STORMS_EDGE_BOY",
      "gfx": "OBJ_EVENT_GFX_BOY_1",
      "x": 42,
      "y": 17,
      "move": "MOVEMENT_TYPE_WANDER_AROUND",
      "text": "Eclair's crew hasn't left the\nsubstation in days. It hums!"
    }
  ],
