  "objects": [
    {
      "id": "LOCALID_REDFIELD_CAYENNE",
      "gfx": "OBJ_EVENT_GFX_WOMAN_2",
      "x": 36,
      "y": 13,
      "move": "MOVEMENT_TYPE_FACE_DOWN",
      "text": "CAYENNE: Welcome to my mill. The sun's\nup: bring a mirror to the sundials.\\n(Story pass: gym introduction.)"
    },
    {
      "id": "LOCALID_REDFIELD_RITA",
      "gfx": "OBJ_EVENT_GFX_WOMAN_2",
      "x": 31,
      "y": 12,
      "move": "MOVEMENT_TYPE_FACE_DOWN",
      "text": "RITA: My Chandelure and I keep the\nmill's books. (Story pass: Mega\\nChandelure battle.)"
    },
    {
      "id": "LOCALID_REDFIELD_FARMHAND",
      "gfx": "OBJ_EVENT_GFX_MAN_1",
      "x": 13,
      "y": 5,
      "move": "MOVEMENT_TYPE_FACE_LEFT",
      "text": "Cane's ready to cut. Don't wander in\nunless you want the whole field\\nto come out at you."
    },
    {
      "id": "LOCALID_REDFIELD_PICKER",
      "gfx": "OBJ_EVENT_GFX_WOMAN_2",
      "x": 13,
      "y": 30,
      "move": "MOVEMENT_TYPE_FACE_LEFT",
      "text": "Peppers by the bushel. Dry, dry\nweather: the best kind for heat."
    },
    {
      "id": "LOCALID_REDFIELD_KEEPER",
      "gfx": "OBJ_EVENT_GFX_OLD_MAN",
      "x": 13,
      "y": 27,
      "move": "MOVEMENT_TYPE_FACE_RIGHT",
      "text": "The great sundial's older than the\nmill. It's never once been wrong."
    },
    {
      "id": "LOCALID_REDFIELD_FOREMAN",
      "gfx": "OBJ_EVENT_GFX_MAN_4",
      "x": 24,
      "y": 34,
      "move": "MOVEMENT_TYPE_FACE_UP",
      "text": "Bottling line's running hot today.\nWatch your eyes."
    },
    {
      "id": "LOCALID_REDFIELD_KID",
      "gfx": "OBJ_EVENT_GFX_LITTLE_BOY",
      "x": 18,
      "y": 19,
      "move": "MOVEMENT_TYPE_WANDER_LEFT_AND_RIGHT",
      "text": "The cane trucks go all the way to\nthe mill. I rode one once!"
    },
    {
      "id": "LOCALID_REDFIELD_BOATMAN",
      "gfx": "OBJ_EVENT_GFX_FISHERMAN",
      "x": 48,
      "y": 28,
      "move": "MOVEMENT_TYPE_FACE_LEFT",
      "text": "Boats to Route 18 run on the river.\n(Story pass: the boat crossing.)"
    }
  ],
