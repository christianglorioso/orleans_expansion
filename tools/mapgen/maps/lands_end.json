      "move": "MOVEMENT_TYPE_FACE_LEFT",
      "text": "JAYDEN: Battle me when you've earned it.\n(Story pass: Jayden battle 5.)"
    },
    {
      "id": "LOCALID_LANDS_END_HERON",
      "gfx": "OBJ_EVENT_GFX_OLD_WOMAN",
      "x": 30,
      "y": 35,
      "move": "MOVEMENT_TYPE_FACE_LEFT",
      "text": "HERON: The rain keeps the true telling.\nWin, and the Gulf is yours. (Story pass: gym, Diving Gear.)"
    },
    {
      "id": "LOCALID_LANDS_END_FISHERMAN",
      "gfx": "OBJ_EVENT_GFX_FISHERMAN",
      "x": 12,
      "y": 30,
      "move": "MOVEMENT_TYPE_FACE_LEFT",
      "text": "Drop a line off the boards, cher.\nThe big ones come up under the boats."
    },
