  "objects": [
    {
      "id": "LOCALID_POINTE_ROUGE_KINGFISHER",
      "gfx": "OBJ_EVENT_GFX_MAN_1",
      "x": 49,
      "y": 40,
      "move": "MOVEMENT_TYPE_FACE_LEFT",
      "text": "KINGFISHER: A badge? Prove you\ncan fish first. Try Route 5's lake!"
    },
    {
      "id": "LOCALID_POINTE_ROUGE_CLERK",
      "gfx": "OBJ_EVENT_GFX_GENTLEMAN",
      "x": 30,
      "y": 17,
      "move": "MOVEMENT_TYPE_WANDER_AROUND",
      "text": "The legislature's in session.\nThirty-four floors of arguing!"
    },
    {
      "id": "LOCALID_POINTE_ROUGE_WORKER",
      "gfx": "OBJ_EVENT_GFX_WORKER_M",
      "x": 20,
      "y": 34,
      "move": "MOVEMENT_TYPE_FACE_LEFT",
      "text": "Shift change at the refinery.\nSmell that? That's overtime."
    },
    {
      "id": "LOCALID_POINTE_ROUGE_ANGLER",
      "gfx": "OBJ_EVENT_GFX_FISHERMAN",
      "x": 47,
      "y": 18,
      "move": "MOVEMENT_TYPE_FACE_RIGHT",
      "text": "The Emerald runs deep here. The\nbig ones hide under the bridge."
    },
    {
      "id": "LOCALID_POINTE_ROUGE_KID",
      "gfx": "OBJ_EVENT_GFX_LITTLE_GIRL",
      "x": 23,
      "y": 4,
      "move": "MOVEMENT_TYPE_WANDER_AROUND",
      "text": "The magnolias smell like lemons!"
    },
    {
      "id": "LOCALID_POINTE_ROUGE_RETIREE",
      "gfx": "OBJ_EVENT_GFX_OLD_MAN",
      "x": 63,
      "y": 13,
      "move": "MOVEMENT_TYPE_FACE_LEFT",
      "text": "Fifty years I've watched barges\npass this bench. Never the same\\lriver twice."
    },
    {
      "id": "LOCALID_POINTE_ROUGE_CHEMIST",
      "gfx": "OBJ_EVENT_GFX_SCIENTIST_1",
      "x": 6,
      "y": 32,
      "move": "MOVEMENT_TYPE_FACE_DOWN",
      "text": "Pressure's steady on column two.\nNobody touch the red valves!"
    },
    {
      "id": "LOCALID_POINTE_ROUGE_YARDMAN",
      "gfx": "OBJ_EVENT_GFX_MAN_3",
      "x": 10,
      "y": 40,
      "move": "MOVEMENT_TYPE_WANDER_LEFT_AND_RIGHT",
      "text": "Tank cars in, tank cars out.\nThe yard never sleeps."
    },
    {
      "id": "LOCALID_POINTE_ROUGE_LASS",
      "gfx": "OBJ_EVENT_GFX_LASS",
      "x": 9,
      "y": 15,
      "move": "MOVEMENT_TYPE_FACE_RIGHT",
      "text": "Our street has the best gardens\nin the whole capital."
    },
    {
      "id": "LOCALID_POINTE_ROUGE_TWIN",
      "gfx": "OBJ_EVENT_GFX_TWIN",
      "x": 37,
      "y": 42,
      "move": "MOVEMENT_TYPE_WANDER_AROUND",
      "text": "Kingfisher's POKéMON fly so fast\nthey ripple the river!"
    },
    {
      "id": "LOCALID_POINTE_ROUGE_POKEFAN",
      "gfx": "OBJ_EVENT_GFX_POKEFAN_M",
      "x": 64,
      "y": 29,
      "move": "MOVEMENT_TYPE_FACE_LEFT",
      "text": "On windy days something huge\ncircles the truss bridge..."
    },
    {
      "id": "LOCALID_POINTE_ROUGE_SHOPPER",
      "gfx": "OBJ_EVENT_GFX_WOMAN_2",
      "x": 44,
      "y": 16,
      "move": "MOVEMENT_TYPE_FACE_LEFT",
      "text": "The Mart's stocked for the session.\nEvery lawmaker wants Potions."
    },
    {
      "id": "LOCALID_POINTE_ROUGE_SAILOR",
      "gfx": "OBJ_EVENT_GFX_SAILOR",
      "x": 53,
      "y": 14,
      "move": "MOVEMENT_TYPE_FACE_RIGHT",
      "text": "SAILOR: The riverboat sails for\nCrescent City from this pier."
    }
  ],
